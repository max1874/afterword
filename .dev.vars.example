# Copy to .dev.vars for local development. In production set these with
# `npx wrangler secret put <NAME>`.

# Proves you are the owner once, at /setup, before your first passkey exists.
OWNER_PASSWORD=change-me

# Optional. Enables film & series search via TMDB (API key or v4 read token).
TMDB_API_KEY=
# Optional. Adds Google Books to book search (Bangumi is always searched).
GOOGLE_BOOKS_API_KEY=
# Optional. Wide artwork for games not on Steam, such as Nintendo and PlayStation
# games (https://www.steamgriddb.com/profile/preferences/api).
STEAMGRIDDB_API_KEY=
# Optional. Official key art for games from IGDB, through a Twitch app's client
# credentials (https://dev.twitch.tv/console/apps).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
